{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/LICENSE.txt",
      "resources/THIRD_PARTY_NOTICES.md"
    ],
    "shortDescription": "A deliberately tiny torrent downloader powered by rqbit",
    "longDescription": "Choose a torrent file, drop it onto the window, or paste a magnet link. Downloads start immediately in the configured folder."
  },
  "productName": "Simplest Torrent",
  "mainBinaryName": "rqbit-desktop",
  "identifier": "design.myldy.simplest-torrent",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Simplest Torrent",
        "width": 780,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
